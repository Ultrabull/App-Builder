# Copy to the host's environment variables (Railway → Variables).
# A long random string. The Pocket AI app must send this to use the agent.
AGENT_TOKEN=change-me-to-a-long-random-secret

# Comma-separated hosts the agent may visit without asking (empty = any, but it
# still asks before sensitive actions). Example: google.com,gmail.com,notion.so
ALLOWLIST=

# Lock API access to your app's origin (recommended). Use * only while testing.
CORS_ORIGIN=https://ultrabull.github.io

# Where the logged-in browser profile is stored. Mount a persistent volume here.
PROFILE_DIR=/data/profile

PORT=8080
